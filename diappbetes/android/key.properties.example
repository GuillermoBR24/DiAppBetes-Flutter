# Copia este archivo como key.properties (ya está en .gitignore) y rellénalo.
# Crear el keystore (una sola vez; guarda copia de seguridad y contraseñas):
#   keytool -genkey -v -keystore C:\ruta\segura\upload-keystore.jks -storetype JKS -keyalg RSA -keysize 2048 -validity 10000 -alias upload
storePassword=CAMBIAR
keyPassword=CAMBIAR
keyAlias=upload
storeFile=C:/ruta/segura/upload-keystore.jks
